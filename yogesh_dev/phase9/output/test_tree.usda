#usda 1.0
(
    defaultPrim = "AppleTree"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "AppleTree"
{
    def Scope "Looks"
    {
        def Material "AppleBark"
        {
            token outputs:surface.connect = </AppleTree/Looks/AppleBark/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </AppleTree/Looks/AppleBark/Tex.outputs:rgb>
                float inputs:roughness = 0.85
                float inputs:metallic = 0
                token outputs:surface
            }
            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/AppleBark.jpg@
                float2 inputs:st.connect = </AppleTree/Looks/AppleBark/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
        def Material "AppleFruit"
        {
            token outputs:surface.connect = </AppleTree/Looks/AppleFruit/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </AppleTree/Looks/AppleFruit/Tex.outputs:rgb>
                float inputs:roughness = 0.85
                float inputs:metallic = 0
                token outputs:surface
            }
            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/AppleFruit.jpg@
                float2 inputs:st.connect = </AppleTree/Looks/AppleFruit/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
        def Material "AppleLeaf"
        {
            token outputs:surface.connect = </AppleTree/Looks/AppleLeaf/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </AppleTree/Looks/AppleLeaf/Tex.outputs:rgb>
                float inputs:roughness = 0.85
                float inputs:metallic = 0
                float inputs:opacity.connect = </AppleTree/Looks/AppleLeaf/Tex.outputs:a>
                float inputs:opacityThreshold = 0.5
                token outputs:surface
            }
            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/AppleLeaf.png@
                float2 inputs:st.connect = </AppleTree/Looks/AppleLeaf/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
                float outputs:a
            }
            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
    }

