    def Mesh "Ground" (
        prepend apiSchemas = ["MaterialBindingAPI", "SemanticsLabelsAPI:class"]
    )
    {
        uniform bool doubleSided = 1
        float3[] extent = [(-400, -400, 0), (400, 400, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </World/Looks/Soil>
        point3f[] points = [(-400, -400, 0), (400, -400, 0), (400, 400, 0), (-400, 400, 0)]
        texCoord2f[] primvars:st = [(0, 0), (100, 0), (100, 100), (0, 100)] (
            interpolation = "vertex"
        )
        token[] semantics:labels:class = ["ground"]
    }

    def "Looks"
    {
        def Material "Soil"
        {
            token outputs:surface.connect = </World/Looks/Soil/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Soil/Tex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.95
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures_scene/soil.png@
                float2 inputs:st.connect = </World/Looks/Soil/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }

        def Material "Hills"
        {
            token outputs:surface.connect = </World/Looks/Hills/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Hills/Tex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 1
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures_scene/hills.png@
                float2 inputs:st.connect = </World/Looks/Hills/uvScale.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }

            def Shader "uvScale"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </World/Looks/Hills/stReader.outputs:result>
                float2 inputs:scale = (6, 6)
                float2 outputs:result
            }
        }
    }

